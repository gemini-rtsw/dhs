for i in $cc_bin_dirs
do
	echo $i/Makefile
	sources=`cd $i; echo *.c`
	sed -e "s/@NAME@/$i/" -e "s/@SOURCES@/$sources/" < Makefile.cc_bin > $i/Makefile
done


for i in $cc_lib_dirs
do
	echo $i/Makefile
	sources=`cd $i; echo *.c`
	sed -e "s/@NAME@/$i/" -e "s/@SOURCES@/$sources/" < Makefile.cc_lib > $i/Makefile
done

for i in $cxx_bin_dirs
do
	echo $i/Makefile
	sources=`cd $i; echo *.C`
	sed -e "s/@NAME@/$i/" -e "s/@SOURCES@/$sources/" < Makefile.cxx_bin > $i/Makefile
done


for i in $cxx_lib_dirs
do
	echo $i/Makefile
	sources=`cd $i; echo *.C`
	sed -e "s/@NAME@/$i/" -e "s/@SOURCES@/$sources/" < Makefile.cxx_lib > $i/Makefile
done
