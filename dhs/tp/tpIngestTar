#
#   Check the arguments
#

if ( $#argv != 3 ) then
    echo "Usage: tpIngestTar <device> <list_file> <status_file>"
    exit 1
endif


#
#   Set variables
#

set device = $1
set list_file = $2
set status_file = $3
set temp_file = "/tmp/tpIngestTar."$device:t".tmp" 
set tape_offset = 0
set stop = 0

#
# Determine which operating system we are using, which changes the
# arguments given to mt and location of gnu tar
# on solaris and hpux.
#

switch( "`/bin/uname -rms`" )
    case SunOS*4.*:
    case SunOS*5.*:
	set os = "sun"
	set gnu_tar = /usr/local/bin/tar
	set gnu_mt = /usr/local/gnu/bin/mt
        breaksw
    case HP-UX*:
	set os = "hp"
	set gnu_tar = /opt/tar/bin/tar
        set gnu_mt = /tmp/cpio-2.4.2/mt
	set advance = 1
        breaksw
    default:
	set os = "unknown"
	set gnu_tar = `which tar`
        set mt_value = `which mt`
	set advance = 1
endsw
if ( $status ) then 
    echo "Error:  Unable to determine the operating system. >> $status_file
    exit 1
endif


#
#  Check that the files can be created.
#

foreach file ( $status_file $list_file )
    rm -f $file
    if ( $status ) then
        exit 1
    endif
    touch $file
    if ( $status ) then
        exit 1
    endif
end

echo $0 $* >>& $status_file


#
#   Rewind the tape
#

echo "$gnu_mt -f $device rewind"  >>& $status_file
$gnu_mt -f $device rewind >>& $status_file
if ( $status ) then
    exit 1
endif


while ( 1 )
    #
    #  Read the files in the current offset.
    #

    echo "( $gnu_tar tvf $device >\! $temp_file" >>& $status_file
    ( $gnu_tar tvf $device >! $temp_file ) >>& $status_file 
    set done = $status
    set num_files = `cat $temp_file | wc -l`
    if ( $status || $num_files <= 0 ) then
	#
	#   Check if we reach the end of the tap EOT.
	#

	echo "$gnu_mt -f $device fsf 1" >> $status_file
	$gnu_mt -f $device fsf 1 >>& $status_file
	if ( $status ) then
	    set stop = "EOT"
	    break
	endif
    endif



    #
    #  Parse the temp file to extract file info.
    #

    ( awk 'BEGIN { file_offset = 0; } /^-/ { printf( "%d\t%d\t%s\t%d\t%d\n", tape_offset, file_offset, $6, $3, $3 ); file_offset++; }' tape_offset=$tape_offset  $temp_file >> $list_file ) >>& $status_file
    if ( $status ) then
        set stop = "Error in awk file processing."
	break
    endif

    @ tape_offset ++
end

rm -f $temp_file

if ( $stop != "EOT" ) then
    exit 1
endif

rm -f $status_file
$gnu_mt -f $device offline >& /dev/null &
exit 0
