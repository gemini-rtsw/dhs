# Makefile

# include configured paths
include conf/include.mk

# make subdirectories
ifneq ($(SYBASE),)
        SUBDIRS += db           # db backend
        SUBDIRS += mfs          # mountable fs
        SUBDIRS += crc          # cyclic redundancy check
        SUBDIRS += cd           # CD-ROM devices
        SUBDIRS += dvd          # DVD devices
        SUBDIRS += tp           # tape library routines
endif

SUBDIRS += ad           	# archive directory
SUBDIRS += press                # compressing library

ifneq ($(SYBASE),)
        SUBDIRS += am           # Archive media access routines
endif

SUBDIRS += gen++                
SUBDIRS += dhsGen
SUBDIRS += dhs++
SUBDIRS += dhsSta
SUBDIRS += dd
SUBDIRS += sf                   # sds <-> fits

ifneq ($(SYBASE),)
        SUBDIRS += fh           # FITS  header storage routines
endif

SUBDIRS += arrayMath            # only for qldp
SUBDIRS += qldp                 # tcl plugin for QlTool
SUBDIRS += dhsCommand
SUBDIRS += dhsConsole
SUBDIRS += dhsData

ifneq ($(DHS_LITE),YES)
        SUBDIRS += dhsGet       # builds, but we don't need it
endif

ifneq ($(SYBASE),)
        SUBDIRS += dhsHistory   # sybase deps to be fixed, we don't need it
endif

SUBDIRS += dhsPut
SUBDIRS += dhsQlServer
SUBDIRS += dhsQlTool            # check, all tcl stuff
SUBDIRS += dhsQlToolDS9         # check, all tcl stuff
SUBDIRS += dhsStatus

ifneq ($(SYBASE),)
        SUBDIRS += dhsStorage          # sybase deps to be fixed, we don't need it
endif

ifneq ($(DHS_LITE),YES)
        SUBDIRS += dhs++Client          # builds, but we don't need it
        SUBDIRS += dhs++Server          # builds, but we don't need it
        SUBDIRS += dhsCmdSender         # builds, but we don't need it
        SUBDIRS += dhsInstSim           # builds, but we don't need it
endif

SUBDIRS += dhsSim4Data

ifneq ($(DHS_LITE),YES)
        SUBDIRS += dhsTestCmdr          # xxx all tcl stuff
        SUBDIRS += fits2sds             # builds, but we don't need it
        SUBDIRS += cdIngest             # unchecked, but we don't need it
        SUBDIRS += cdOnline             # unchecked, but we don't need it
        SUBDIRS += mediaCleanup         # unchecked, but we don't need it
        SUBDIRS += mediaPrep            # unchecked, but we don't need it
        SUBDIRS += mediaQueue           # unchecked, but we don't need it
        SUBDIRS += mediaWrite           # unchecked, but we don't need it
        SUBDIRS += testCmdr             # check, all tcl stuff
endif

ifneq ($(SYBASE),)
        SUBDIRS += tpIngest
endif

# fixme - move that in sub-directories

SCRIPTS = \
	scripts/dhsCleanup \
	scripts/GemBootStart \
	scripts/TestBootStart \
	scripts/MakeClassicalMedia \
	scripts/MakePrImages \
	scripts/MakeUserMedia \
	scripts/newsyslog \
	scripts/qlToolInst.sh \
	scripts/qlToolWFS.sh \
	scripts/qlToolAltair.sh \
	scripts/dhsServerStart.sh \
	scripts/dhsServerStop.sh \
	scripts/dhsServerRestart.sh \
	scripts/rescue \
	dhsQlTool/dhsQlTool \
	dhsQlToolDS9/dhsQlToolDS9

RELEASE_DIRS = \
	release \
	release/bin \
	release/include \
	release/lib \
	release/scripts \
	release/sql \
	release/images \
	release/config \
	release/man \
	release/man/man1 \
	release/man/man3 \
	release/man/mann


# compile
all: install_dirs
	for i in $(SUBDIRS); do (cd $$i; echo "$$i:"; $(MAKE) all install)  || exit 1 ; done

setup: 

# remove generated files
clean: FORCE
	for i in $(SUBDIRS); do (cd $$i; echo "$$i:"; $(MAKE) $@)  || exit 1 ; done

# also remove files generated by configure
distclean: clean
	rm -f config.status config.cache config.log confdefs.h include.mk

depend:
	rm -f */*.d

# create the installation directories, if needed
install_dirs: FORCE
	@for i in ${RELEASE_DIRS}; do test -d $$i || mkdir $$i; done

install_scripts: FORCE
	-cp -uf ${SCRIPTS} release/scripts
#	(cd release/bin; ln -sf ../scripts/dhsQlTool; ln -sf ../scripts/dhsQlToolDS9)

install_config: FORCE
	-cp -uf */*.config release/config

install_sql: FORCE
	-cp -uf */*.sql release/sql

install_xbm: FORCE
	-cp -f */*.xbm release/images

install_includes: FORCE
	-cp -f */*.h release/include

install_subdirs: FORCE
	-for i in $(SUBDIRS); do (cd $$i; echo "$$i:"; $(MAKE) install) done

install_man: FORCE
	-cp -f */*.1 release/man/man1
	-cp -f */*.3 release/man/man3
	-cp -f */*.n release/man/mann


# install generated files in release dir
install: install_dirs install_subdirs install_man install_scripts \
	install_config install_sql install_xbm install_includes

FORCE:

etags tags:
	etags \
	  `find . -name '*.[CchH]' -print` \
	  `find $(DHS_CLIENT_TOP) -name '*.[CchH]' -print`
