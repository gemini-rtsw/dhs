# -*-makefile-*-
# Common make definitions

# Root DHS source dir
TOP = ..

# Root dhsClient source dir
DHS_CLIENT_TOP = @DHS_CLIENT_INSTALL_BASE@

# Release install directory
RELEASE_DIR = $(TOP)/release

# System dependent libraries
SYSLIBS = -lpthread -lrt @LIBS@ -lm


# DRAMA Directories
IMP_DIR = @IMP_DIR@
SDS_DIR = @SDS_DIR@
ERS_DIR = @ERS_DIR@

DRAMA_INCLUDES = \
	-I${IMP_DIR}  \
	-I${SDS_DIR} \
	-I${ERS_DIR}

DRAMA_LDLIBS += -L${IMP_DIR} -limp -Wl,-rpath=${IMP_DIR}
DRAMA_LDLIBS += -L${SDS_DIR} -lsds -Wl,-rpath=${SDS_DIR}
DRAMA_LDLIBS += -L${ERS_DIR} -lers -Wl,-rpath=${ERS_DIR}

# Root dir for Tcl include files and libs
TCL_VERSION = @TCL_VERSION@
TCLTK_ROOT = @TCLTK_ROOT@
TCLTK_INCLUDES = -I$(TCLTK_ROOT)/include
TCLTK_LDLIBS = -L$(TCLTK_ROOT)/lib -ltcl$(TCL_VERSION) -ltk$(TCL_VERSION)

DHS_LITE = @DHS_LITE@

SKYCAT = @SKYCAT@
SKYCAT_INCLUDES = -I$(SKYCAT)/include/astrotcl -I$(SKYCAT)/include/tclutil 
SKYCAT_LDLIBS = -L$(SKYCAT)/lib -lastrotcl -ltclutil -Wl,-rpath=$(SKYCAT)/lib

# Root dir for Sybase include files and libs
SYBASE = @SYBASE@
ifeq ($(SYBASE),)
   SYBASE_INCLUDES =
   SYBASE_LDLIBS =
   SYBASE_DHS_FLAGS = -USYBASE_DHS
else
   SYBASE_INCLUDES = -I$(SYBASE)/include
   SYBASE_LDLIBS = -L$(SYBASE)/lib -lsybdb
   SYBASE_DHS_FLAGS = -DSYBASE_DHS
endif

# Base dir for Epics
EPICS_BASE = @EPICS_BASE@
ifeq ($(EPICS_BASE),)
   EPICS_DHS_FLAGS = -UEPICS_DHS
   EPICS_BASE_INCLUDES =
   EPICS_BASE_LDLIBS =
else
   EPICS_DHS_FLAGS = -DEPICS_DHS
   UNAME = $(shell uname)
   EPICS_BASE_INC_OS = $(UNAME)
   ifeq ($(EPICS_BASE_INC_OS),SunOS)
       EPICS_BASE_INC_OS = solaris
   endif
   EPICS_BASE_INCLUDES = -I$(EPICS_BASE)/include -I$(EPICS_BASE)/include/os/$(EPICS_BASE_INC_OS) 

   EPICS_BASE_LIB_OS = $(UNAME)
   ifeq ($(EPICS_BASE_LIB_OS),SunOS)
       EPICS_BASE_LIB_OS = solaris-sparc-gnu
   endif
   ifeq ($(EPICS_BASE_LIB_OS),Linux)
       EPICS_BASE_LIB_OS = linux-x86
   endif
   EPICS_BASE_LDLIBS = -L$(EPICS_BASE)/lib/${EPICS_BASE_LIB_OS} -lca -lCom -Wl,-rpath=$(EPICS_BASE)/lib/${EPICS_BASE_LIB_OS}
endif

# CFITSIO
CFITSIO_INCLUDES = @CFITSIO_INCLUDES@
CFITSIO_LDLIBS = @CFITSIO_LDLIBS@
CFITSIO_FLAGS = @CFITSIO_FLAGS@

# C include options
INCLUDES += -I.

ifneq ($(SYBASE),)
   INCLUDES += -I$(TOP)/am
   INCLUDES += -I$(TOP)/cd
   INCLUDES += -I$(TOP)/db
   INCLUDES += -I$(TOP)/dvd
   INCLUDES += -I$(TOP)/mfs
   INCLUDES += -I$(TOP)/tp
endif

INCLUDES += -I$(TOP)/ad
INCLUDES += -I$(TOP)/dd
INCLUDES += -I$(TOP)/press
INCLUDES += -I$(TOP)/sf
INCLUDES += -I$(DHS_CLIENT_TOP)/include
INCLUDES += ${DRAMA_INCLUDES}
INCLUDES += ${TCLTK_INCLUDES}
INCLUDES += ${SYBASE_INCLUDES}
INCLUDES += ${EPICS_BASE_INCLUDES}
INCLUDES += ${CFITSIO_INCLUDES}
INCLUDES += ${SKYCAT_INCLUDES}

# C++ include options
CXX_INCLUDES += $(INCLUDES)
CXX_INCLUDES += -I$(TOP)/arrayMath
CXX_INCLUDES += -I$(TOP)/dhsGen
CXX_INCLUDES += -I$(TOP)/dhs++
CXX_INCLUDES += -I$(TOP)/dhsSta
CXX_INCLUDES += -I$(TOP)/gen++

ifneq ($(SYBASE),)
   CXX_INCLUDES += -I$(TOP)/crc
   CXX_INCLUDES += -I$(TOP)/fh
   CXX_INCLUDES += -I$(TOP)/mfs
endif

# Define options
DEFINES = @DEFS@ -DDSTDARG_OK -D_POSIX -DPOSIX_SOURCE $(CFITSIO_FLAGS) $(SYBASE_DHS_FLAGS) $(EPICS_DHS_FLAGS)

# local library dependencies
LOCAL_LIBS += $(TOP)/arrayMath/libarrayMath.a
LOCAL_LIBS += $(TOP)/dhsGen/libdhsGen.a
LOCAL_LIBS += $(TOP)/dhs++/libdhs++.a
LOCAL_LIBS += $(TOP)/dhsSta/libdhsSta.a
LOCAL_LIBS += $(TOP)/gen++/libgen++.a
LOCAL_LIBS += $(TOP)/dd/libdd.a
LOCAL_LIBS += $(TOP)/press/libpress.a
LOCAL_LIBS += $(TOP)/sf/libsf.a
LOCAL_LIBS += $(DHS_CLIENT_TOP)/lib/libdhs.a
LOCAL_LIBS += $(DHS_CLIENT_TOP)/lib/libgen.a

ifneq ($(SYBASE),)
   LOCAL_LIBS += $(TOP)/fh/libfh.a
   LOCAL_LIBS += $(TOP)/ad/libad.a
   LOCAL_LIBS += $(TOP)/am/libam.a
   LOCAL_LIBS += $(TOP)/cd/libcd.a
   LOCAL_LIBS += $(TOP)/db/libdb.a
   LOCAL_LIBS += $(TOP)/dvd/libdvd.a
   LOCAL_LIBS += $(TOP)/mfs/libmfs.a
   LOCAL_LIBS += $(TOP)/tp/libtp.a
   LOCAL_LIBS += $(TOP)/crc/libcrc.a
endif

# LD flags for local libs
LOCAL_LDFLAGS += -L$(TOP)/arrayMath
LOCAL_LDFLAGS += -L$(TOP)/dhsGen
LOCAL_LDFLAGS += -L$(TOP)/dhs++
LOCAL_LDFLAGS += -L$(TOP)/dhsSta
LOCAL_LDFLAGS += -L$(TOP)/gen++
LOCAL_LDFLAGS += -L$(TOP)/dd
LOCAL_LDFLAGS += -L$(TOP)/press
LOCAL_LDFLAGS += -L$(TOP)/sf
LOCAL_LDFLAGS += -L$(TOP)/ad

ifneq ($(SYBASE),)
   LOCAL_LDFLAGS += -L$(TOP)/fh
   LOCAL_LDFLAGS += -L$(TOP)/mfs
   LOCAL_LDFLAGS += -L$(TOP)/am
   LOCAL_LDFLAGS += -L$(TOP)/cd
   LOCAL_LDFLAGS += -L$(TOP)/db
   LOCAL_LDFLAGS += -L$(TOP)/dvd
   LOCAL_LDFLAGS += -L$(TOP)/mfs
   LOCAL_LDFLAGS += -L$(TOP)/tp
   LOCAL_LDFLAGS += -L$(TOP)/crc
endif

INSTALL_DIR = @INSTALL_DIR@
LOCAL_LDFLAGS += -Wl,-rpath=$(INSTALL_DIR)/lib

LOCAL_LDFLAGS += -L$(DHS_CLIENT_TOP)/lib
LOCAL_LDFLAGS += -Wl,-rpath=$(DHS_CLIENT_TOP)/lib

# Linker options
LDFLAGS += -g @LDFLAGS@

# Libraries to link
LDLIBS += ${LOCAL_LDFLAGS}
LDLIBS += ${LIBS}
LDLIBS += ${CFITSIO_LDLIBS}
LDLIBS += ${DRAMA_LDLIBS}
LDLIBS += ${EPICS_BASE_LDLIBS}
LDLIBS += ${SYBASE_LDLIBS}
LDLIBS += ${SKYCAT_LIBS}
LDLIBS += ${TCLTK_LIBS}
LDLIBS += $(SYSLIBS) 

# Set to ":" if there is no ranlib command
RANLIB = @RANLIB@

# C compiler
CC = @CC@ -m32

# C++ compiler
CXX = @CXX@ -m32

# For now, assume gcc, otherwise this needs to go into configure.in
SHLIB_CFLAGS += -fPIC
SHLIB_LDFLAGS += -shared

# C Compiler options
CFLAGS += -g @CFLAGS@ $(SHLIB_CFLAGS) ${DEFINES} ${INCLUDES} ${CXX_INCLUDES} 

# C++ Compiler options
CXXFLAGS += @CFLAGS@  $(CFLAGS)

# Script used to install files
INSTALL = @INSTALL@

# Development source dirs
ETAGS_SOURCES = $(TOP)/*/*.[Cch]

