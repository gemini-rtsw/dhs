#
# FILENAME
# dhsHistory/config/dhsHistory.config
#
# PURPOSE:
# Configuration file for the history server.
#
#INDENT-OFF*
#
#INDENT-ON*
#
#***  C A N A D I A N   A S T R O N O M Y   D A T A   C E N T R E  *****
#***********************************************************************
#

#
# Application identification.
#
# Identity	Application 
# Keyword	Identifier
# --------	-----------
#

identity	historyServerSS


#
# IMP information.
#
# Imp		Maximum Number
# Keyword	of Connections
# --------	--------------
#

imp		20		30


#
# Status server identification information.
#
# Server	Server's IMP	Host
# Keyword	Identity	Address
# -------	------------	-------
#

statusServer	statusServerSS	cpodhs03


#
# Data server identification information.
#
# Data Server	Server's IMP	Host
# Keyword	Identity	Address
# -----------	------------	-------
#

dataServer	dataServerSS	cpodhs03


#
# Database server and table names.
#
# Database 	DB Server	History		History Events	History Labels 
# Keyword	Name		Database	Table		Table
# --------	---------	--------	-------		-----
#

database	GEMINI_SOUTH_SUMMIT dhsDB	historyEvents	historyLabels


#
# Working directory to use for history server's files.  
#
# Directory	Path to 
# Keyword	Directory
# ---------	---------
#

directory	/staging/history


#
# EPICS Channel Access information - list of channels to monitor.
#
# Channel	Channel
# Keyword	Name
# -------	-------
#


channel		DHSS:logMessage
#channel		DHS:STA:debug
#channel		DHS:DTS:debug
