#
# TReCS:    added by Hon Sept. 2001
#           Modified by T. Hayward, 2002 May 31
#           2002 June  6, TLH: more mods.
#           2002 July 18, TLH: change some data types to double, correct many discrepencies esp. in Inst. section
#           2002 Nov   5, TLH: Added DETSET, stepper mechanism POS keywords.
#           2003 Jul   5, TLH: Added WELLDPTH and BIASLEVL keywords.
#           2003 Jul  23, TLH: Removed unneeded instrument temperature, BKWXXX, and SIGXXX keywords.
#                              Changed SLITWHL to GRATMOT.
#                              Added USRNOTE
#	    2003 Aug  28, TLH: Added new BKAXXX, RDAXXX, and SIGXXX keywords.
#	    2003 Dec  18, TLH: Changed OBJTIME units to sec, SAVEFREQ to SAVETIME, minor changes to a few comments
#	    2004 Feb  24, TLH: Added HRCENWL

#Instrument        Attribute     Data      Keyword      Gemini   Null    Array  Column  Comment
#                 Name in SDS    Type    Name in Fits   Mandat   Value   Value   Name
#------------   --------------  -----   --------------  ------  ------  ------  ------  --------------------------------------

# MEF File format
OK TReCS       extensionName    STRING  EXTNAME		F       NULL    INDEX   NULL    "Name assigned to a FITS extension."
OK TReCS       extensionVersion INT     EXTVER   	F	NULL    INDEX   NULL    "Number assigned to a FITS extension."
OK TReCS       frameId          STRING  FRAMEID		F       NULL    NONE    NULL    "Frame ID"
# Next two go in primary header to indicate number of extensions
OK TReCS	NNODS  		INT	NNODS  		F	NULL	NONE	NULL	"Number of Nod Phases (1 or 2)"
OK TReCS	NNODSETS	INT	NNODSETS	F	NULL	NONE	NULL	"Number of Nod Sets"
# Next two go in extension header to indicate nod phase and nodset number
OK TReCS	NOD		STRING	NOD		F	NULL	NONE	NULL	"Name of Nod Phase (A or B)"
OK TReCS	NODSET		INT	NODSET		F	NULL	NONE	NULL	"Index of NodSet"

# these are here to substitute for naxis3 & 4 in each mef extension frame if naxis>2 does not really work. -- hon
OK TReCS	NCHOPS 		INT	NCHOPS  	F	NULL	NONE	NULL	"Number of Chop Phases (NAXIS3: 1 or 2)"
OK TReCS	NSAVSETS	INT	NSAVSETS	F	NULL	NONE	NULL	"Number of Chop Sets (NAXIS4)"

#
# Data Source
#
OK TReCS	OBSERVAT 	STRING	OBSERVAT	F	Gemini	NONE	NULL	"Gemini North or Gemini South"
OK TReCS 	telescope	STRING	TELESCOP	F	Gemini	NONE	NULL	"Telescope where data taken"
OK TReCS	instrument	STRING	INSTRUME	F	NULL	NONE	instrument	"Instrument used to acquire data."

#
