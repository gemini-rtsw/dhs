#
#  bHROS keywords
#  Fri Jul 15 09:35:01 CLT 2005, Pedro Gigoux
#	Added keywords from Randy's email
#  Mon Jul 18 15:03:01 CLT 2005, Pedro Gigoux
#	Added telescope, obsid, OBSCLASS, IAA, POFFSET, QOFFSET
#  Wed Jul 20 14:38:29 CLT 2005, Pedro Gigoux
#	Changed INSTRUME to instrument
#  Thu Jul 21 08:46:51 CLT 2005
#	Added GCALLAMP, GCALFILT, GCALDIFF, GCALSHUT, dataType,
#	      frameName, frameId, HROSTHT
#	Changed DATATYP to DATATYPE (DHS name only)
#
OK bHROS telescope  STRING  TELESCOP   F  Gemini NONE  NULL  "Telescope"
