##
## Extensions same keywords appear in all four extensions
##
##
## WCS
##
OK GSAOI        CTYPE1         	DOUBLE  CTYPE1                 	F       NULL    NONE    NULL    "RA in tangent plane projection"
OK GSAOI        CRPIX1         	DOUBLE  CRPIX1                 	F       NULL    NONE    NULL    "Ref pix of axis 1"
OK GSAOI        CRVAL1         	DOUBLE  CRVAL1                 	F       NULL    NONE    NULL    "RA at ref pix in demand degrees"
OK GSAOI        CTYPE2         	DOUBLE  CTYPE2                 	F       NULL    NONE    NULL    "DEC in tangent plane projection"
OK GSAOI        CRPIX2         	DOUBLE  CRPIX2                 	F       NULL    NONE    NULL    "Ref pix of axis 2"
OK GSAOI        CRVAL2         	DOUBLE  CRVAL2                 	F       NULL    NONE    NULL    "DEC at ref pix in demand degrees"
OK GSAOI        CD1_1         	DOUBLE  CD1_1                 	F       NULL    NONE    NULL    "Partial of first axis coord w.r.t. x"
OK GSAOI        CD1_2         	DOUBLE  CD1_2                 	F       NULL    NONE    NULL    "Partial of first axis coord w.r.t. y"
OK GSAOI        CD2_1         	DOUBLE  CD2_1                 	F       NULL    NONE    NULL    "Partial of second axis coord w.r.t. x"
OK GSAOI        CD2_2         	DOUBLE  CD2_2                 	F       NULL    NONE    NULL    "Partial of second axis coord w.r.t. y"
OK GSAOI        REDECSYS        STRING  REDECSYS                F       NULL    NONE    NULL    "RA/DEC coordinate system reference"
OK GSAOI        PIXSCALE        DOUBLE  PIXSCALE                F       NULL    NONE    NULL    "Pixel scale (in arecsec)"
