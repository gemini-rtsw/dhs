# FILENAME
# dhsStoPut/config/dhsStoPut.config
#
# PURPOSE:
# Configuration for for the dhsStoPut, a DHS Storage Server client.
#
#INDENT-OFF*
# $Log: dhsStoPut.config,v $
# Revision 1.2  2001/01/12 22:36:18  jaeger
# Added "host address" to the identity information so that multiple
# identities could be listed in the configurationfile. Added "numCopies"
# field to the default configuration information.  Changed "EXA" to
# "EXABYTE" in the "retrieve" column since this is what retrieve uses.
#
# Revision 1.1  2000/12/04 22:04:39  jaeger
# Initial revision
#
#INDENT-ON*
#
#***  C A N A D I A N   A S T R O N O M Y   D A T A   C E N T R E  *****
#***********************************************************************
#

#
#  Application Identification.
#
#
# Keyword       Host Address	Identity
# -------       ------------
#

identity	archie		dhsStoPutArchie


#
# Storage Server to connect to and IP Address.
#
# Keyword       Idenity         Host Address
# -------       -------         ------------
#

storageServer    storageServerNB    sabrina


#
# Organization creating the media.
#
# Keyword       organization
# -------       -------------
#

organization	Gemini


#
# Default command-line argument values.
#
# Keyword	compression	mediaType	numCopies
# -------	-----------     ---------	---------

defaults	ASIS		CD		1


#
# MediaType Mapping
#
#
# Keyword	retrieve type	DHS (storage) type
# -------	-------------   ------------------
#

mediaType	FTP		MD
mediaType	EXABYTE		EXABYTE
mediaType	CD		CD
mediaType	DVD		DVD



