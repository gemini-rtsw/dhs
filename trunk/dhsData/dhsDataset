########################################################################
#
#   Subroutine:	configRead
#
#   Purpose:
#	Read the dhsData.config and libAd.config files.  It stores the
#	values read in global variables.
#
#   Arguments:
#	None.
#
#   Return values:
#	None.
#
########################################################################
#-

sub	configRead
{
    $fnameAd = "libAd.config";
    $fnameData = "dhsData.config";


    #
    #  Read the libAd.config file.
    #

    $configPath = $ENV{DEFAULT_CONFIG_DIR};
    if ( $configPath eq "" )
    {
    	print( STDERR "ERROR: Environment variable DEFAULT_CONFIG_DIR is undefined\n" );
	exit;
    }

    $filename = "$configPath/$fnameAd";
    if ( ! open( FH, $filename ) )
    {
	print( STDERR "ERROR: Cannot read $filename\n" );
	exit;
    }

    while ( <FH> )
    {
	if ( /^database/ )
	{
	    ( $void, $server, $database ) = split;
	}
	elsif ( /^medium(.*)MD/ )
	{
	    ( $void, $void, $void, $tblMdfiles, $tblMds ) = split;
	}
    	elsif ( /^remote/ )
	{
	    ( $void, $site, $tblRemoteFiles ) = split;
	}
    }

    close( FH );

    if ( $site eq "" || $server eq ""
	    || $database eq "" || $tblMdfiles eq ""
	    || $tblMds eq "" )
    {
    	print( STDERR "ERROR:  Missing configuration values in $filename\n" );
	exit;
    }
    

    #
    #  Read the dhsData.config file.
    #

    $filename = "$configPath/$fnameData";
    if ( ! open( FH, $filename ) )
    {
	print( STDERR "ERROR: Cannot read $filename\n" );
	exit;
    }

    while ( <FH> )
    {
	if ( /^database/ )
	{
	    ( $void, $s, $d, $tblUnique, $tblDataset, $tblProcess ) = split;
	    if ( $s ne $server || $d ne $database )
	    {
		print( STDERR "ERROR: keyword database is configured differently in:\n" );
		print( STDERR "           $configPath/$fnameData\n" );
		print( STDERR "           $configPath/$fnameAd\n" );
		exit;
	    }
	}
	elsif ( /^fitsTable/ )
	{
	    ( $void, $tblFitsHeader ) = split;
	}
	elsif ( /^identity/ )
	{
	    ( $void, $identity ) = split;
	}
    	elsif ( /^storage/ )
	{
	    ( $void, $tempDiskname, $permDiskname ) = split;
	}
    }

    close( FH );

    if ( $tblUnique eq "" || $tblDataset eq ""
	    || $tblProcess eq "" || $tblFitsHeader eq ""
	    || $identity eq "" || $tempDiskname eq ""
	    || $permDiskname eq "" )
    {
    	print( STDERR "ERROR:  Missing configuration values in $filename\n" );
	exit;
    }
}
