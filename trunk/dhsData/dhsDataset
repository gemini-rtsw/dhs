#+
########################################################################
#
#   Subroutine:	datasetInfo
#
#   Purpose:
#	Returns the diskname, disk mount point and the filename for the
#	given dataset.  This function dies if:
#		1.  The dataset is not in the $tblMdfiles tables; or
#		2.  The dataset is in the dataset table.
#
#   Arguments:
#	dataset		: Name of dataset for queries.
#
#   Return values:
#	diskname	: Name of disk on which to find dataset.
#	mountPoint	: The mount point of the disk.
#	filename	: The dataset's file name on disk.
#
########################################################################
#-

sub	datasetInfo
{
    local( $dataset ) = @_;


    #
    #  Determine if the dataset is in the $tblDataset table.  If so
    #  the dataset is fully processed and cannot be changed.
    #

    doSql( "select datasetName = datasetName
	    from $tblDataset
	    where datasetName = '$dataset'" );

    %buffer = &dbnextrow( $dbproc, 1 );
    $datasetName = $buffer{ 'datasetName' };
    dbcanquery( $dbproc );
    
    if ( $datasetName ne "" )
    {
	print( STDERR "ERROR: dataset \"$dataset\" has been fully processed and cannot be changed\n" );
	exit;
    }


    #
    #  Determine if the where the dataset lives on disk and whether it
    #  is permDiskname or tempDiskname.
    #

    doSql( "select diskname = f.diskname,
		    mountPoint = d.mount_point,
		    fname = f.fname
	    from $tblMds d, $tblMdfiles f
	    where d.diskname = f.diskname 
		    and f.file_id = '$dataset'" );

    %buffer = &dbnextrow( $dbproc, 1 );
    $diskname = $buffer{ 'diskname' };
    $mountPoint = $buffer{ 'mountPoint' };
    $filename = $buffer{ 'fname' };
    dbcanquery( $dbproc );

    return( $diskname, $mountPoint, $filename );
}
