########################################################################
#
#   Subroutine:	datasetAdd
#
#   Purpose:
#	Adds dataset rows to tables and creates a zero length file for
#	testing.
#
#   Arguments:
#	dataset		: Name of dataset to create.
#
#   Return values:
#	None.
#
########################################################################
#-

sub	datasetAdd
{
    local( $dataset, $diskname, $flag, $mountPoint ) = @_;

    $filename = "$dataset.raw";
    system( "touch $mountPoint/$filename" );
    if ( ! -e "$mountPoint/$filename" )
    {
    	print( STDERR "ERROR: Cannot create $mountPoint/$filename" );
	exit;
    }

    doSql( "begin transaction" );
    doSql( "insert $database..$tblMdfiles
	    values( '$dataset', '$diskname', '$filename',
		    0, 'C', 0, ' ', 'R' )" );

    doSql( "insert $database..$tblRemoteFiles
	    values ( '$dataset', '$diskname', '$site', 'C', ' ', 'R' )" );

    doSql( "insert $database..$tblProcess
	    values ( '$dataset', '$dataset', getdate(),
		    ' ', '$flag', 'H', ' ', ' ', 'R', 'dhsPut' )" );

    doSql( "insert $database..$tblFitsHeader ( datasetName )
		    values( '$dataset' )" );

    doSql( "insert $database..$tblUnique values( '$dataset', getdate() )" );

    doSql( "commit transaction" );
}
