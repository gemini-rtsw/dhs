########################################################################
#
#   Subroutine:	dbConnect
#
#   Purpose:
#	Connects to the database, prompting user for missing login info.
#
#   Arguments:
#	None.
#
#   Return values:
#	None.
#
########################################################################
#-

sub	dbConnect
{

    $value = `dbrc_get $server $database` ||
	    die "ERROR: Cannot exec script 'dbrc_get'\n";

    ( $username, $password ) = split( /[ \t\n]+/, $value );


    #
    #  Login in with the same identity as the DHS Data Server.
    #  This will ensure that the Data Server cannot be run while
    #  this script is running.
    #

    $dbproc = dblogin( $username, $password, $server, $identity );
    if ( $dbproc == -1 )
    {
	print( STDERR "ERROR: Can't login into \"$server\"\n" );
	exit;
    }

    if ( ! dbuse( $database ) )
    {
	print( STDERR "ERROR: Can't use database \"$database\"\n" );
	exit;
    }
}
#
#+
########################################################################
#
#   Subroutine:	doSql
#
#   Purpose:
#	Executes an SQL query.
#
#   Arguments:
#	@_		: Query buffer
#
#   Return values:
#	None.
#
########################################################################
#-

sub	doSql
{
    local( $sql ) = @_;

    &dbcmd( $sql ) || die "Error: in dbcmd.\n" ;
    &dbsqlexec || die "Error: in dbsqlexec.\n" ;
    &dbresults;
}
