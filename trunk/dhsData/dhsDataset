########################################################################
#
#   Subroutine:	datasetMove
#
#   Purpose:
#	Move a dataset from PERM to TEMP or vice versa.
#
#   Arguments:
#	dataset		: Name of dataset to move.
#
#   Return values:
#	None.
#
########################################################################
#-

sub	datasetMove
{
    local( $dataset ) = @_;


    ( $currentDiskname, $currentMountPoint, $filename ) =
	    datasetInfo( $dataset );


    #
    #  Test for existence on disk before proceeding.
    #

    if ( $currentDiskname eq "" )
    {
	print( STDERR
		"ERROR: dataset \"$dataset\" not in $tblMdfiles table\n" );
    	exit;
    }

    if ( ! -e "$currentMountPoint/$filename" )
    {
	print( STDERR "ERROR: $currentMountPoint/$filename: No such file\n" );
	exit;
    }


    #
    #  Set the new lifetime and location.
    #

    if ( $currentDiskname eq $permDiskname )
    {
    	$newDiskname = $tempDiskname;
	$newLifetime = "T";
    }
    else
    {
    	$newDiskname = $permDiskname;
	$newLifetime = "P";
    }


    #
    #  Get the new mount point.
    #

    doSql( "select mountPoint = mount_point
	    from $tblMds d
	    where diskname = '$newDiskname'" );

    %buffer = &dbnextrow( $dbproc, 1 );
    $newMountPoint = $buffer{ 'mountPoint' };
    dbcanquery( $dbproc );

    
    #
    #  Move the file.
    #

    if ( ! rename( "$currentMountPoint/$filename",
	    "$newMountPoint/$filename" ) )
    {
	print( STDERR "ERROR: Cannot move $filename from $currentMountPoint to $newMountPoint\n" );
	exit;
    }


    #
    #  Change type and location of the file in all the tables.
    #

    doSql( "begin transaction" );

    doSql( "update $tblRemoteFiles 
	    set media_id = '$newDiskname'
	    where file_id = '$dataset'
		    and media_id = '$currentDiskname'
		    and site_id = '$site'" );

    doSql( "update $tblProcess 
	    set lifetime = '$newLifetime',
		    ssNotify = ' '
	    where datasetName = '$dataset'" );

    doSql( "update $tblMdfiles
	    set diskname = '$newDiskname'
	    where file_id = '$dataset'
		    and diskname = '$currentDiskname'" );

    doSql( "commit" );
}
#
#+
########################################################################
#
#   Subroutine:	datasetRemove
#
#   Purpose:
#	Removes a dataset from either PERM or TEMP.
#
#   Arguments:
#	dataset		: Name of dataset to remove.
#
#   Return values:
#	None.
#
########################################################################
#-

sub	datasetRemove
{
    local( $dataset ) = @_;

    
    ( $diskname, $mountPoint, $filename ) = datasetInfo( $dataset );

    #
    #  If the file exists on disk, remove it.
    #

    if ( $mountPoint ne "" && -e "$mountPoint/$filename" )
    {
	if ( ! unlink( "$mountPoint/$filename" ) )
	{
	    print( STDERR "ERROR: Cannot remove $mountPoint/$filename\n" );
	    exit;
	}
    }


    #
    #  Remove the file from all the tables.
    #

    doSql( "begin transaction" );

    doSql( "delete $tblRemoteFiles 
	    where file_id = '$dataset' 
	    and site_id = '$site'" );

    doSql( "delete $tblProcess 
	    where datasetName = '$dataset'" );

    doSql( "delete $tblFitsHeader
	    where datasetName = '$dataset'" );

    doSql( "delete $tblUnique
    	    from $tblUnique u
	    where not exists (
	    	select *
		from $tblProcess p
		where p.uniqueName = u.uniqueName )" );

    doSql( "delete $tblMdfiles
	    where file_id = '$dataset'" );

    doSql( "commit" );
}
#
#+
########################################################################
#
#   Subroutine:	dbCheck
#
#   Purpose:
#	Checks that the database tables exist and that the Data Server
#	is not running.  Also extracts information about the disk mount
#	points.
#
#   Arguments:
#	None.
#
#   Return values:
#	None.
#
########################################################################
#-

sub	dbCheck
{
    doSql( "select num = count(*)
	    from master..sysprocesses
	    where program_name = '$identity'" );
    %buffer = &dbnextrow( $dbproc, 1 );
    $num = $buffer{ 'num' };
    dbcanquery( $dbproc );

    if ( $num > 1 )
    {
    	print( STDERR "ERROR: the DHS Data Server '$identity' must be shutdown\n" );
	print( STDERR "       before running this script\n" );
	exit
    }

    doSql( "select mount_point = mount_point
	    from $database..$tblMds
	    where diskname = '$permDiskname'" );
    %buffer = &dbnextrow( $dbproc, 1 );
    $permMountPoint = $buffer{ 'mount_point' };
    dbcanquery( $dbproc );

    if ( $permMountPoint eq "" )
    {
    	print( STDERR "ERROR: Cannot find the mount point in $database..$tblMds\n" );
	print( STDERR "       for the disk named '$permDiskname'\n" );
	exit;
    }

    doSql( "select mount_point = mount_point
	    from $database..$tblMds
	    where diskname = '$tempDiskname'" );
    %buffer = &dbnextrow( $dbproc, 1 );
    $tempMountPoint = $buffer{ 'mount_point' };
    dbcanquery( $dbproc );

    if ( $tempMountPoint eq "" )
    {
    	print( STDERR "ERROR: Cannot find the mount point in $database..$tblMds\n" );
	print( STDERR "       for the disk named '$tempDiskname'\n" );
	exit;
    }
}
