#+
########################################################################
#
#   Subroutine:	doTest
#
#   Purpose:
#	Add rows to the dataset tables for testing the functions of
#	this program.
#
#   Arguments:
#	None.
#
#   Return values:
#	None.
#
########################################################################
#-

sub	doTest
{
         
    $permDataset = "__dhsDataset_test_PERM";
    $tempDataset = "__dhsDataset_test_TEMP";


    #
    #  Add the PERM and TEMP datasets to the data server tables.
    #

    datasetAdd( $permDataset, $permDiskname, "P", $permMountPoint );
    datasetAdd( $tempDataset, $tempDiskname, "T", $tempMountPoint );


    #
    #  Move the datasets to the other lifetime.
    #

    datasetMove( $permDataset );
    datasetMove( $tempDataset );


    #
    #  And finally, delete the datasets.
    #

    datasetRemove( $permDataset );
    datasetRemove( $tempDataset );
}
