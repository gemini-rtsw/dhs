########################################################################
#
#   Subroutine:	cmdLineParse
#
#   Purpose:
#	Parses and verifies the command line arguments and stores
#	values in global variables.
#
#   Arguments:
#	None.
#
#   Return values:
#	None.
#
########################################################################
#-

sub	cmdLineParse
{

    GetOptions( "mv" => \$move,
	    "rm" => \$remove,
	    "test" => \$test ) || printUsage();

    if ( $test )
    {
	if ( $#ARGV != -1 )
	{
	    printUsage();
	}
    }
    else
    {
	if ( ( $move eq "" && $remove eq "" )
		|| ( $move ne "" && $remove ne "" )
		|| $#ARGV != 0 )
	{
	    printUsage();
	}

	$dataset = $ARGV[0];
    }
}
