unshift(@INC, "/usr/cadc/misc/lib/perl5/Sybase");
require "sybperl.pl";
use Getopt::Long;


#
#  Initialize global variables.  This should be tailored for instance of the
#  DHS database.
#

$appname = "dhsDataset";


#
#  Parse the command line.
#

cmdLineParse();



#
#  Read the configuration files.
#

configRead();


#
#  Connect to the database and check tables.
#

dbConnect();
dbCheck();


#
#  Process.
#

if ( $test )
{
    doTest();
}
elsif ( $move )
{
    datasetMove( $dataset );
}
else
{
    datasetRemove( $dataset );
}


#
#  Close the database connection.
#

&dbclose( $dbproc );


