#
#  Application identification
#
# Keyword	application 
#
# -------	-----------
#

identity	qlServer


#
#  Imp information
#
# keyword	Max connects
#
# --------	------------
#

imp		20


#
#  Status server identification information.
#
# keyword	Identity	address
#
# -------	--------	-------
#

statusServer	statusServer	daxka


#
#  Master quick look server id.
#
# keyword	name		address
# -------	----		-------
#

masterId	qlServer	daxka


#
#  Data server id.
#
# keyword	name		address
# -------	----		-------
#

dataServerId	dataServer1	daxka



#  Default quick look streams.
#
# keyword	name
#
# -------	----
#

qlStream	gmosFlat
qlStream	gmosBias
qlStream	gmosScience
qlStream	gmosScience2
qlStream	gmosScience3
qlStream	gmosScience4
qlStream	gmosScience5
qlStream	gmosScience6
qlStream	gmosScience7
qlStream	gmosScience8
qlStream	gmosScience9
qlStream	gmosScience10
qlStream	gmosScience11


