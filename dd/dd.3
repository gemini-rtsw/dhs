.SH NAME
dd, ddAttribGet, ddExit, ddGetNext, ddInit, ddKeywordGet
\- Data dictionary access routines.


.SH SYNOPSIS
.LP
.nf
#include "gen_types.h"		
#include "gen_eptr.h"
#include "gen_str.h"
#include "gen_msg.h"

#include "dd.h
.ft
.fi
.LP
.\".nf
.\".ta 0.8i
.TP 7n
void
ddAttribGet( char *
.IR instrument,
char *
.IR keyword,
DD_ROW **
.IR row,
DD_STATUS
.IR *ddStatus
);
.TP 7n
void
ddExit( DD_STATUS
.IR *ddStatus
);
.TP 7n
void
ddGetNext( int
