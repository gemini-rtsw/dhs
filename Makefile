# Makefile

# include configured paths
include conf/include.mk

# make subdirectories
SUBDIRS = \
	db \
	ad \
	mfs \
	crc \
	cd \
	dvd \
	tp \
	press \
	am \
	gen++ \
	dhsGen \
	dhs++ \
	dhsSta \
	dd \
	sf \
	fh \
	arrayMath \
	qldp \
	dhsCommand \
	dhsConsole \
	dhsData \
	dhsGet \
	dhsHistory \
	dhsPut \
	dhsQlServer \
	dhsQlTool \
	dhsQlToolDS9 \
	dhsStatus \
	dhsStorage \
	dhs++Client \
	dhs++Server \
	dhsCmdSender \
	dhsInstSim \
	dhsSim4Data \
	dhsTestCmdr \
	fits2sds \
	cdIngest \
	cdOnline \
	mediaCleanup \
	mediaPrep \
	mediaQueue \
	mediaWrite \
	testCmdr \
	tpIngest \



SCRIPTS = \
	scripts/dhsCleanup \
	scripts/GemBootStart \
	scripts/TestBootStart \
	scripts/MakeClassicalMedia \
	scripts/MakePrImages \
	scripts/MakeUserMedia \
	scripts/newsyslog \
	dhsQlTool/dhsQlTool \
	dhsQlToolDS9/dhsQlToolDS9

RELEASE_DIRS = \
	release \
	release/bin \
	release/include \
	release/lib \
	release/scripts \
	release/sql \
	release/images \
	release/config \
	release/man \
	release/man/man1 \
	release/man/man3 \
	release/man/mann


# compile
all: install_dirs
	for i in $(SUBDIRS); do (cd $$i; echo "$$i:"; $(MAKE) all install)  || exit 1 ; done

setup: 

# remove generated files
clean: FORCE
	for i in $(SUBDIRS); do (cd $$i; echo "$$i:"; $(MAKE) $@)  || exit 1 ; done

# also remove files generated by configure
distclean: clean
	rm -f config.status config.cache config.log confdefs.h include.mk

depend:
	rm -f */*.d

# create the installation directories, if needed
install_dirs: FORCE
	@for i in ${RELEASE_DIRS}; do test -d $$i || mkdir $$i; done

install_scripts: FORCE
	-cp -uf ${SCRIPTS} release/scripts
	(cd release/bin; ln -sf ../scripts/dhsQlTool; ln -sf ../scripts/dhsQlToolDS9)

install_config: FORCE
	-cp -uf */*.config release/config

install_sql: FORCE
	-cp -uf */*.sql release/sql

install_xbm: FORCE
	-cp -f */*.xbm release/images

install_includes: FORCE
	-cp -f */*.h release/include

install_subdirs: FORCE
	-for i in $(SUBDIRS); do (cd $$i; echo "$$i:"; $(MAKE) install) done

install_man: FORCE
	-cp -f */*.1 release/man/man1
	-cp -f */*.3 release/man/man3
	-cp -f */*.n release/man/mann

install_imp: FORCE
	-cp ${IMP_DIR}/${DRAMA_OS}/master release/bin
	-cp ${IMP_DIR}/${DRAMA_OS}/receiver release/bin
	-cp ${IMP_DIR}/${DRAMA_OS}/transmitter release/bin
	d=`pwd`/release/lib/; \
	  (cd ${IMP_DIR}/${DRAMA_OS}; tar cf - *.so* | (cd $$d; tar xvf -)) ; \
	  (cd ${ERS_DIR}/${DRAMA_OS}; tar cf - *.so* | (cd $$d; tar xvf -)) ; \
	  (cd ${SDS_DIR}/${DRAMA_OS}; tar cf - *.so* | (cd $$d; tar xvf -))


# install generated files in release dir
install: install_dirs install_subdirs install_man install_scripts \
	install_config install_sql install_xbm install_includes \
	install_imp

FORCE:

etags tags:
	etags \
	  `find . -name '*.[CchH]' -print` \
	  `find ../dhsClient -name '*.[CchH]' -print` \
	  `find ../cfitsio -name '*.[CchH]' -print` \
